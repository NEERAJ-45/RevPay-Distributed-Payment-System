### ─────────────────────────────────────────────────────────
###  USER SERVICE — Authentication & Profile
### Base URL: http://localhost:8081 (direct) or http://localhost:8080 (via Gateway)
### ─────────────────────────────────────────────────────────

@baseUrl = http://localhost:8081
@gatewayUrl = http://localhost:8080
@aliceToken = {{registerAlice.response.body.data.token}}
@bobToken = {{registerBob.response.body.data.token}}

### ─────────────────────────────────────────────────────────
### 1.1 Register Alice
### ─────────────────────────────────────────────────────────
# @name registerAlice
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "fullName": "Alice Sharma",
  "phone": "9876543210",
  "pin": "1234"
}

### ─────────────────────────────────────────────────────────
### 1.2 Register Bob
### ─────────────────────────────────────────────────────────
# @name registerBob
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "fullName": "Bob Singh",
  "phone": "9876543211",
  "pin": "5678"
}

### ─────────────────────────────────────────────────────────
### 1.3 Register Charlie (for multi-party tests)
### ─────────────────────────────────────────────────────────
# @name registerCharlie
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "fullName": "Charlie Kapoor",
  "phone": "9876543212",
  "pin": "9012"
}

### ─────────────────────────────────────────────────────────
### 1.4 Login Alice
### ─────────────────────────────────────────────────────────
# @name loginAlice
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "phone": "9876543210",
  "pin": "1234"
}

### ─────────────────────────────────────────────────────────
### 1.5 Login Bob
### ─────────────────────────────────────────────────────────
# @name loginBob
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "phone": "9876543211",
  "pin": "5678"
}

### ─────────────────────────────────────────────────────────
### 1.6 Register — Duplicate Phone (should fail with 409)
### ─────────────────────────────────────────────────────────
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "fullName": "Fake Alice",
  "phone": "9876543210",
  "pin": "0000"
}

### ─────────────────────────────────────────────────────────
### 1.7 Register — Invalid Phone (should fail with 400)
### ─────────────────────────────────────────────────────────
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "fullName": "Bad Phone",
  "phone": "12345",
  "pin": "1234"
}

### ─────────────────────────────────────────────────────────
### 1.8 Get Logged-in User Profile (via Gateway)
### ─────────────────────────────────────────────────────────
GET {{gatewayUrl}}/users/me
Authorization: Bearer {{aliceToken}}

### ─────────────────────────────────────────────────────────
### 1.9 Lookup User by UPI ID
### ─────────────────────────────────────────────────────────
GET {{baseUrl}}/users/alice@miniupi
Authorization: Bearer {{aliceToken}}

### ─────────────────────────────────────────────────────────
### 1.10 Get QR Code for UPI ID
### ─────────────────────────────────────────────────────────
GET {{baseUrl}}/users/qr/alice@miniupi
Authorization: Bearer {{aliceToken}}
